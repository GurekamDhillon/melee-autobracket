# Settings for autobracket-backup.sh. Copy to /etc/autobracket/backup.env (mode 0600, root).
# KEY=value lines; this file is sourced by bash, so quote values with spaces. Every setting
# is optional; the value shown is the default.

# Where the backups go. Created if missing, forced to mode 0700; files are 0600. LOCAL ONLY:
# nothing copies this directory anywhere else. If you change it, change ReadWritePaths= in
# autobracket-backup.service to match.
#BACKUP_DIR=/var/backups/autobracket

# The server's SQLite database (db_path in autobracket.toml). With the systemd unit this is
# the StateDirectory; /var/lib/autobracket is a symlink to /var/lib/private/autobracket.
#SQLITE_DB=/var/lib/autobracket/autobracket.sqlite

# The sqlite3 command-line tool (Debian/Ubuntu: `apt install sqlite3`).
#SQLITE3=sqlite3

# How many backups of each kind to keep; older ones are deleted after each run.
#KEEP=7

# Zitadel's Postgres, dumped with pg_dump inside its Docker container. Leave PG_CONTAINER
# empty (the default) to skip the Postgres dump entirely.
#   PG_CONTAINER   container name for `docker exec`, e.g. zitadel-db-1; or, with
#                  PG_COMPOSE_FILE set, the compose SERVICE name, e.g. db
#   PG_COMPOSE_FILE path of the compose file: dump with `docker compose -f FILE exec -T`
#                  instead of `docker exec`
#   PG_USER        Postgres role for pg_dump (must be able to read PG_DATABASE)
#   PG_DATABASE    database to dump
#   DOCKER         the docker command
#PG_CONTAINER=
#PG_COMPOSE_FILE=
#PG_USER=postgres
#PG_DATABASE=zitadel
#DOCKER=docker
